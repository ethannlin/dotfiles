background = #282c34
foreground = #abb2bf
cursor-color = #528bff
selection-background = #3e4451
selection-foreground = #abb2bf

# Normal colors
palette = 0=#282c34
palette = 1=#e06c75
palette = 2=#98c379
palette = 3=#e5c07b
palette = 4=#61afef
palette = 5=#c678dd
palette = 6=#56b6c2
palette = 7=#abb2bf

# Bright colors
palette = 8=#5c6370
palette = 9=#e06c75
palette = 10=#98c379
palette = 11=#d19a66
palette = 12=#61afef
palette = 13=#c678dd
palette = 14=#56b6c2
palette = 15=#ffffff
font-family = MesoLGL Nerd Font Mono
font-size = 18
adjust-cursor-thickness = 1

working-directory = home

clipboard-read = allow
clipboard-write = allow
window-save-state = always

auto-update = check
auto-update-channel = stable

shell-integration-features = no-cursor,no-title
cursor-style = block

macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

mouse-scroll-multiplier = 2
mouse-hide-while-typing = true
title = " "
macos-icon = official

# Similar Tmux but with Ghostty
# (ctrl b for tmux -> cmb b for ghostty)
keybind = super+b>r=reload_config
keybind = super+b>x=close_surface
# this only works if you have `macos-titlebar-style = tabs or native or transparent`
# else it behaves like new window
keybind = super+b>c=new_tab
keybind = super+b>n=new_window

# splitting
keybind = super+b>\=new_split:right
keybind = super+b>-=new_split:down
keybind = super+b>e=equalize_splits

# split nav (setting this to control will not work if tmux already uses it)
keybind = super+b>h=goto_split:left
keybind = super+b>j=goto_split:bottom
keybind = super+b>k=goto_split:top
keybind = super+b>l=goto_split:right

keybind = super+shift+left=resize_split:left,10
keybind = super+shift+down=resize_split:down,10
keybind = super+shift+up=resize_split:up,10
keybind = super+shift+right=resize_split:right,10

copy-on-select = clipboard
